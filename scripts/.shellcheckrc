# ----------------------------------------------------------------------------------------------------------------------
# ShellCheck project configuration (scripts/**)
# ----------------------------------------------------------------------------------------------------------------------
# SoT: .claude/output-styles/utility-shell-script-style.md  ·  .claude/rules/utility-shell-script-rule.md
#
# Location matters: ShellCheck resolves .shellcheckrc by walking the checked file's own directory and its
# ancestors — never a sibling. This file therefore lives at scripts/ rather than scripts/base/, so that
# scripts/containers/**, scripts/deploy/** and scripts/tools/** are covered too. Moving it back down would
# silently narrow the gate to scripts/base/** while the header still claimed scripts/**.
#
# Principle: the disable= entries below are limited to the "structural false positives" that arise from this
#            project's `source`-based modular architecture. Real defects (SC2086 missing quotes · SC2002 useless cat ·
#            SC2009 ps|grep · SC2181 $? · SC2046, etc.) are not disabled — they are fixed directly in the scripts,
#            so the quality gate is not weakened.
# ----------------------------------------------------------------------------------------------------------------------

# Lint with the Bash dialect (project scripts use #!/bin/bash; the #!/bin/sh entrypoint defers to each file's shebang).
shell=bash

# ----------------------------------------------------------------------------------------------------------------------
# Disabled rules — structural false positives only (ShellCheck accumulates multiple disable= lines)
# ----------------------------------------------------------------------------------------------------------------------

# SC2034: library variables consumed by the sourcing parent → look "unused" to ShellCheck, which sees only the single file.
disable=SC2034

# SC2168: 'local' in a sourced sub-script executed outside a named function (e.g. base/_platform.sh · _project.sh).
disable=SC2168

# SC1091: the source path is dynamic (${PROJECT_PATH}/…), so it cannot be resolved at lint time.
disable=SC1091

# SC2155: declare+assign on one line (local X="$(cmd)") is allowed by project convention for readability.
disable=SC2155

# SC2024: sudo combined with output redirection (intentional — privilege escalation then file write in install scripts).
disable=SC2024

# NOTE: SC2225 ("cp has no destination", error severity) is NOT disabled globally — that would neutralize the cp
#       missing-destination bug repository-wide. All 24 cp uses in scripts/** currently have a destination, so it
#       never triggers. If a specific line yields a false positive, scope it narrowly with an inline
#       `# shellcheck disable=SC2225` on that line.

# ----------------------------------------------------------------------------------------------------------------------
# External source tracking
# ----------------------------------------------------------------------------------------------------------------------

# Follow sourced scripts to enable cross-file analysis, and resolve paths relative to each script's directory.
external-sources=true
source-path=SCRIPTDIR

# ----------------------------------------------------------------------------------------------------------------------
# Enforced project convention — always brace variable expansions "${VAR}"
# ----------------------------------------------------------------------------------------------------------------------
# SoT: utility-shell-script-rule.md "Always expand variables quoted and braced (${VAR})". This was deferred behind a
# comment until the bulk cleanup it required was done; scripts/** is clean under it as of this change, so it is now a
# merge gate rather than a convention that depends on reviewer vigilance. There is no special-parameter exemption —
# ${REPLY} in a select menu is braced like everything else, and the SoT examples were updated to match.
# Note the scope: ShellCheck resolves .shellcheckrc from the checked file's own ancestors, so this covers scripts/**
# only. .claude/hooks/** has no rc file and is already brace-clean.
enable=require-variable-braces
